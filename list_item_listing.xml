<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/box_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:padding="8dp"
        android:background="@color/white">

        <!-- Top: image + all info (waste, supplier, type, price) -->
        <LinearLayout
            android:id="@+id/box_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgWaste"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:padding="5dp"
                android:src="@drawable/type1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_margin="8dp">

                <TextView
                    android:id="@+id/txtWasteName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waste: Palm leaves"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSupplierName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Supplier: Ali Farms"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type: Organic"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price: 100 AED"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <!-- Bottom: amount + Make Offer + Buy Directly -->
        <LinearLayout
            android:id="@+id/box_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/edtAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="Enter amount"
                android:inputType="numberDecimal"
                android:padding="6dp"
                android:background="@android:drawable/edit_text" />

            <Button
                android:id="@+id/btnMakeOffer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Make Offer" />

            <Button
                android:id="@+id/btnBuyDirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buy Directly" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
